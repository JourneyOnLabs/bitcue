[Unit]
Description=BitCue (relay and job tracking)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=z1screen
Group=z1screen
WorkingDirectory=/opt/z1screen
Environment=PYTHONPATH=/opt/z1screen
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m z1screen --state /var/lib/z1screen --library /opt/z1screen/library
StateDirectory=z1screen
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
