# Shows the job screen full screen on the Pi's monitor, with no desktop.
# Uses the cage kiosk compositor, started like its documented systemd unit.
[Unit]
Description=BitCue display
After=systemd-user-sessions.service plymouth-quit-wait.service getty@tty1.service z1screen.service
Wants=z1screen.service dbus.socket systemd-logind.service
After=dbus.socket systemd-logind.service
Conflicts=getty@tty1.service
ConditionPathExists=/dev/tty1

[Service]
Type=simple
User=@USER@
PAMName=z1screen-kiosk
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland
ExecStartPre=/bin/sh -c 'for i in $(seq 1 60); do curl -fs http://127.0.0.1:8080/health >/dev/null && exit 0; sleep 1; done; exit 0'
ExecStart=/usr/bin/cage -d -s -- @CHROMIUM@ --kiosk --noerrdialogs --disable-infobars --no-first-run --disable-session-crashed-bubble --disable-features=Translate,TranslateUI --check-for-update-interval=31536000 --password-store=basic --ozone-platform=wayland --autoplay-policy=no-user-gesture-required --incognito --user-data-dir=/tmp/z1screen-chromium http://127.0.0.1:8080/
Restart=always
RestartSec=5

[Install]
WantedBy=graphical.target
