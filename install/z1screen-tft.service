# Draws the job screen on the Pi's small screen: the 2.8-inch PiTFT or the 3.5-inch DPI LCD (no desktop or browser).
# It reads the screen data from z1screen.service on this Pi and never talks to the machine itself;
# a start on the touch screen is passed to z1screen.service, which checks it and sends it.
[Unit]
Description=BitCue on the Pi's small screen
Wants=z1screen.service
# Starts early in the boot, as soon as the files are there, so its splash replaces the boot text (the
# installer also keeps the boot messages off the screen). It shows the splash until z1screen.service answers.
DefaultDependencies=no
After=local-fs.target
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=simple
User=z1screen
Group=z1screen
# video: draw on /dev/fbN. tty: keep the text console off the screen if it lands there.
# input: read the touch layer (/dev/input/eventN).
SupplementaryGroups=video tty input
# Raspberry Pi OS 13 lets only root open a text console, so systemd opens tty1, the one the Pi starts on, for
# this program (systemd before 253 skips this line; there the tty group may open it)
OpenFile=/dev/tty1:tty1:graceful
AmbientCapabilities=CAP_SYS_TTY_CONFIG
CapabilityBoundingSet=CAP_SYS_TTY_CONFIG
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
WorkingDirectory=/opt/z1screen
Environment=PYTHONPATH=/opt/z1screen
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m z1screen.tft
Restart=always
RestartSec=3

[Install]
WantedBy=sysinit.target
